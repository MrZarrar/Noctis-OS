{
  "name": "noctis-os",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first orchestration operating environment",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -b",
    "build:desktop": "npm --workspace @noctis/desktop run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "rust:check": "cargo check --workspace --locked",
    "rust:clippy": "cargo clippy --workspace --locked --all-targets -- -D warnings",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:test": "cargo test --workspace --locked",
    "typecheck": "tsc -b --pretty false",
    "test:boundary": "node --test scripts/donor-port/verify-read-only.test.mjs",
    "test:deploy": "node --test scripts/deploy/*.test.mjs",
    "test:desktop": "node --test apps/desktop/tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:migrations": "vitest run apps/core/src/db",
    "test:integration": "vitest run --passWithNoTests integration.test",
    "test:e2e": "node --test --test-reporter=spec apps/web/e2e/*.test.mjs",
    "test:security": "vitest run --passWithNoTests tests/security",
    "test:performance": "vitest run --passWithNoTests tests/performance",
    "build:web": "npm --workspace @noctis/web run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "eslint": "10.9.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "framer-motion": "13.5.0",
    "motion-dom": "13.5.0",
    "motion-utils": "13.5.0"
  }
}
