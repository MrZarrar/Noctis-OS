{
  "name": "noctis-os",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first orchestration operating environment",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -b",
    "build:desktop": "npm --workspace @noctis/desktop run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "rust:check": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml --locked",
    "rust:clippy": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "rust:fmt:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check",
    "rust:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --locked",
    "typecheck": "tsc -b --pretty false",
    "test:boundary": "node --test scripts/donor-port/verify-read-only.test.mjs",
    "test:desktop-bootstrap": "node --test apps/desktop/tests/bootstrap.test.mjs",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests apps/core/tests/integration",
    "test:e2e": "node --test --test-reporter=spec apps/web/e2e/*.test.mjs",
    "test:security": "vitest run --passWithNoTests tests/security",
    "test:performance": "vitest run --passWithNoTests tests/performance"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
