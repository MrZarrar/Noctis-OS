NOCTIS_ENVIRONMENT=development
NOCTIS_CORE_HOST=127.0.0.1
NOCTIS_CORE_PORT=43120
NOCTIS_DATA_DIR=.noctis/data
NOCTIS_VAULT_ROOT=.noctis/test-vault
NOCTIS_ALLOW_METERED_PROVIDERS=0

# Browser origins permitted to reach the core. Empty is the default and refuses
# every browser: a page sends Origin on every request, including its own
# same-origin POST to /session/login, and the origin gate runs before the login
# exemption. So the cookie realm is unreachable until this names the origin the
# front door is served from — for example https://noctis.<tailnet>.ts.net. A
# native shell and the node agent send no Origin and are unaffected.
NOCTIS_ALLOWED_ORIGINS=

# How long a browser session lasts, in whole hours, 1-8760. Default 720 (thirty
# days), so a phone is not asked to log in weekly.
NOCTIS_SESSION_TTL_HOURS=720

# Where the built web app lives, served at / when set. Unset in development,
# where Vite serves the page and the core only allowlists its origin. Set to
# apps/web/dist where the core serves the page to a phone: `tailscale serve`
# maps one hostname to one port, and the SameSite=Strict session cookie only
# reaches the core from a page on the core's own origin.
#
# Setting this requires NOCTIS_ALLOWED_ORIGINS above: the core refuses to start
# without it, because the page would load and then be unable to log in or
# stream. The directory must contain index.html.
#
# Build the page in a shell that does NOT have VITE_CORE_TOKEN set. Vite inlines
# VITE_-prefixed variables into the bundle, and the core serves that bundle
# before the credential gate, so a dev token in the build environment ends up
# readable by anyone who can reach the port. `vite build` refuses outright if it
# finds one.
NOCTIS_WEB_ROOT=
