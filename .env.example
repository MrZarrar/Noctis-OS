# Every variable the core reads, with the name it actually reads. Copy to .env
# for a development core; the work-PC deployment sets these as Windows
# user-scoped variables instead, never as a file — see
# docs/operations/work-pc-core.md.

# Required. 32+ random characters. Every node credential derives from it, and
# it is the token the browser exchanges once for a session cookie.
NOCTIS_CORE_TOKEN=

# Required. The SQLite file itself, not a directory. Keep it outside the repo
# and outside OneDrive.
NOCTIS_DATABASE_PATH=.noctis/core.db

# Default 127.0.0.1. Anything else needs NOCTIS_ALLOW_NON_LOOPBACK=true, and
# the deployed shape does not: `tailscale serve` proxies to loopback.
NOCTIS_CORE_BIND=127.0.0.1

# Default 7717 (DEFAULT_PORT). 0 lets the OS pick, which is what tests use.
NOCTIS_CORE_PORT=7717

# debug | info | warn | error. Default info.
NOCTIS_LOG_LEVEL=info

# Browser origins permitted to reach the core. Empty is the default and refuses
# every browser: a page sends Origin on every request, including its own
# same-origin POST to /session/login, and the origin gate runs before the login
# exemption. So the cookie realm is unreachable until this names the origin the
# front door is served from — for example https://noctis.<tailnet>.ts.net. A
# native shell and the node agent send no Origin and are unaffected.
NOCTIS_ALLOWED_ORIGINS=

# How long a browser session lasts, in whole hours, 1-8760. Default 720 (thirty
# days), so a phone is not asked to log in weekly.
NOCTIS_SESSION_TTL_HOURS=720

# Where the built web app lives, served at / when set. Unset in development,
# where Vite serves the page and the core only allowlists its origin. Set to
# apps/web/dist where the core serves the page to a phone: `tailscale serve`
# maps one hostname to one port, and the SameSite=Strict session cookie only
# reaches the core from a page on the core's own origin.
#
# The directory must contain index.html AND assets/ — that is how the core
# tells a build from the web app's source tree, which also has an index.html
# and would otherwise be served whole, unauthenticated, ahead of the credential
# gate. `npm run build:web` writes it. `npm run build` does not: that is
# `tsc -b`, and it builds no bundle.
#
# Setting this requires NOCTIS_ALLOWED_ORIGINS above: the core refuses to start
# without it, because the page would load and then be unable to log in or
# stream.
#
# Build the page in a shell that does NOT have VITE_CORE_TOKEN set. Vite inlines
# VITE_-prefixed variables into the bundle, and the core serves that bundle
# before the credential gate, so a dev token in the build environment ends up
# readable by anyone who can reach the port. `vite build` refuses outright if it
# finds one.
NOCTIS_WEB_ROOT=

# Web push. All three or none; one or two set is a ConfigurationError at
# startup. They are NOT set here: NOCTIS_VAPID_PRIVATE_KEY is a credential, and
# a credential does not go in a repository file even as a placeholder. Generate
# the pair with `npx web-push generate-vapid-keys` and set all three as Windows
# user-scoped environment variables — the runbook has the exact commands.
#
#   NOCTIS_VAPID_PUBLIC_KEY   65 bytes, url-safe base64, unpadded
#   NOCTIS_VAPID_PRIVATE_KEY  32 bytes, same encoding. A credential.
#   NOCTIS_VAPID_SUBJECT      mailto: or https:// URL

# The embedded remote desktop (ADR-0035). Both or neither; unset is off. The
# key FILE is a credential (it signs Gateway tokens) and lives outside the repo,
# beside the database; only its path goes in the environment. The Windows
# password is never configured anywhere — the panel asks for it per session.
#
#   NOCTIS_REMOTE_DESKTOPS              JSON: [{"host","gatewayUrl":"wss://…/jet/rdp","destination":"host:3389"}]
#   NOCTIS_GATEWAY_PROVISIONER_KEY_FILE RSA-2048+ PEM private key; the Gateway holds the public half

# The Vault. Unset means no Vault, which is the default. NOCTIS_VAULT_ALLOW_LIVE
# and NOCTIS_VAULT_ALLOW_WRITES are separate gates on top of it, both off.
NOCTIS_VAULT_ROOT=
